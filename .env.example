# Copy this file to .env.local and fill in your Supabase project credentials.
# Both values are public/anon-safe and are required for the contact form and
# any future client-side reads of destinations/experiences from Supabase.
# Find them in Supabase Dashboard -> Project Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
