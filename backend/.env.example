# Copy this file to .env and fill in what you need. Nothing here is
# required for the API to run — enquiries are always saved to
# backend/data/enquiries.json regardless of whether email is configured.

PORT=4000

# Frontend origin(s) allowed to call this API (comma-separated for more than one)
CORS_ORIGIN=http://localhost:3000

# Optional: email notification for each new enquiry (via SMTP, e.g. Gmail App Password,
# SendGrid, Resend SMTP, etc). Leave blank to skip email and rely on the saved file only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
