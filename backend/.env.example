# Copy this file to .env and fill in what you need.

PORT=4000

# Frontend origin(s) allowed to call this API (comma-separated for more than one)
CORS_ORIGIN=http://localhost:3000

# --- Admin dashboard --------------------------------------------------------
# Password for the /admin login on the frontend. Required for admin login to
# work at all — without it, /api/admin/login always returns 503.
ADMIN_PASSWORD=

# Signs admin session tokens. Required in production — without it, a random
# secret is generated per process start and every admin gets logged out on
# each restart/deploy. Generate one with: openssl rand -hex 32
JWT_SECRET=

# --- Database ----------------------------------------------------------------
# Optional. When unset, enquiries are saved to backend/data/enquiries.json
# instead — fine for local dev, not durable in most production hosts (e.g.
# Render's free tier wipes local disk on redeploy). Set this to a Postgres
# connection string (e.g. Render's managed Postgres) for production.
DATABASE_URL=

# --- Email notification (optional) -------------------------------------------
# Leave blank to skip email and rely on the saved enquiry only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
NOTIFY_EMAIL=
